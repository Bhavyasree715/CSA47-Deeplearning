
import numpy as np
import matplotlib.pyplot as plt
import math
mean = 70
std_dev = 10
lower = 60
upper = 80
z1 = (lower - mean) / std_dev
z2 = (upper - mean) / std_dev
p1 = 0.5 * (1 + math.erf(z1 / math.sqrt(2)))
p2 = 0.5 * (1 + math.erf(z2 / math.sqrt(2)))

probability = p2 - p1
print("Mean =", mean)
print("Standard Deviation =", std_dev)
print("Probability between 60 and 80 =", round(probability, 4))
print("Percentage =", round(probability * 100, 2), "%")
x = np.linspace(30, 110, 1000)
y = (1 / (std_dev * math.sqrt(2 * math.pi))) * np.exp(
    -0.5 * ((x - mean) / std_dev) ** 2
)
plt.plot(x, y, label="Normal Distribution")
mask = (x >= lower) & (x <= upper)
plt.fill_between(x[mask], y[mask], alpha=0.5,
                 label="Probability between 60 and 80")

plt.axvline(lower, linestyle="--", label="Score = 60")
plt.axvline(upper, linestyle="--", label="Score = 80")

plt.xlabel("Examination Marks")
plt.ylabel("Probability Density")
plt.title("Normal Distribution of Examination Marks")
plt.legend()
plt.grid(True)
plt.show()
