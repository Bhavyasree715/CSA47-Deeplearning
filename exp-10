
import numpy as np
import matplotlib.pyplot as plt
C = np.array([
    [5, 2],
    [2, 2]
])
eigenvalues, eigenvectors = np.linalg.eig(C)
index = np.argmax(eigenvalues)
principal_eigenvalue = eigenvalues[index]
principal_eigenvector = eigenvectors[:, index]
print("Covariance Matrix:")
print(C)

print("\nEigenvalues:")
print(eigenvalues)

print("\nEigenvectors:")
print(eigenvectors)

print("\nLargest Eigenvalue:")
print(principal_eigenvalue)

print("\nPrincipal Eigenvector:")
print(principal_eigenvector)

plt.figure()

for i in range(len(eigenvalues)):
    if i == index:
        label = "Principal Eigenvector"
    else:
        label = "Other Eigenvector"

    plt.quiver(
        0, 0,
        eigenvectors[0, i],
        eigenvectors[1, i],
        angles='xy',
        scale_units='xy',
        scale=1,
        label=label
    )

plt.xlim(-1, 1.5)
plt.ylim(-1, 1.5)

plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("Eigenvectors and Principal Direction")

plt.axhline(0, color='black')
plt.axvline(0, color='black')

plt.grid(True)
plt.legend()
plt.show()
