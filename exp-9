
import numpy as np
import matplotlib.pyplot as plt
C = np.array([
    [3, 1],
    [1, 3]
])
eigenvalues, eigenvectors = np.linalg.eig(C)
print("Covariance Matrix:")
print(C)

print("\nEigenvalues:")
print(eigenvalues)

print("\nEigenvectors:")
print(eigenvectors)
plt.figure()

for i in range(len(eigenvalues)):
    plt.quiver(
        0, 0,
        eigenvectors[0, i],
        eigenvectors[1, i],
        angles='xy',
        scale_units='xy',
        scale=1,
        label="Eigenvalue = " + str(eigenvalues[i])
    )
plt.xlim(-1, 1.5)
plt.ylim(-1, 1.5)

plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("Eigenvectors of Covariance Matrix")

plt.axhline(0, color='black')
plt.axvline(0, color='black')

plt.grid(True)
plt.legend()
plt.show()
